# ─────────────────────────────────────────────────────────────
#  R2 / S3 object storage
# ─────────────────────────────────────────────────────────────
R2_ENDPOINT=https://d126d2072cbefe37feb7b2c948b83f63.r2.cloudflarestorage.com
R2_BUCKET=sari
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# sari-manifest.json holds all metadata; it lives in the same bucket.
R2_MANIFEST_KEY=sari-manifest.json

# ─────────────────────────────────────────────────────────────
#  Deletion protection — anyone may upload, only a moderator deletes.
#  Set MODERATOR_PASSCODE to a long random string (e.g. `openssl rand -hex 24`).
#  While it is empty, DELETE requests are refused entirely.
# ─────────────────────────────────────────────────────────────
MODERATOR_PASSCODE=
MODERATOR_COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────
#  Optional limits
# ─────────────────────────────────────────────────────────────
UPLOADS_ENABLED=true
UPLOAD_RATE_LIMIT_PER_HOUR=40
