# ─────────────────────────────────────────────────────────────
#  R2 / S3 object storage
# ─────────────────────────────────────────────────────────────
R2_ENDPOINT=https://d126d2072cbefe37feb7b2c948b83f63.r2.cloudflarestorage.com
R2_BUCKET=sari
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# sari-manifest.json holds all metadata; it lives in the same bucket.
R2_MANIFEST_KEY=sari-manifest.json

# ─────────────────────────────────────────────────────────────
#  Admin — deletion is reserved to admins, who log in at /admin.
#  Set ADMIN_PASSCODE to a long random string (at least 8 characters);
#  `openssl rand -hex 24` is a good way to generate one.
#  While it is empty, NOBODY can delete anything.
# ─────────────────────────────────────────────────────────────
ADMIN_PASSCODE=
# Optional: a separate secret for signing the admin cookie. Falls back to
# ADMIN_PASSCODE when empty, which is fine for a single-course site.
ADMIN_COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────
#  Optional limits
# ─────────────────────────────────────────────────────────────
UPLOADS_ENABLED=true
UPLOAD_RATE_LIMIT_PER_HOUR=40

# Avvisi: quanti avvisi può pubblicare lo stesso client in un'ora
NEWS_RATE_LIMIT_PER_HOUR=20
